<Page x:Class="PostOffice.SearchShipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PostOffice"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SearchShipmentPage" Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Text="Поиск:" FontSize="18" VerticalAlignment="Center"/>
            <TextBox x:Name="poisk" Width="400" Height="30" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" TextChanged="poisk_TextChanged"/>
            <Button x:Name="sbros" Width="80" Height="30" Content="Сброс" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" Click="sbros_Click" Background="LightSkyBlue"/>
            <TextBlock Text="Изменить статус:" FontSize="18" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="statuscmb" Width="300" Height="30" FontSize="16" Margin="10,0,0,0" DisplayMemberPath="name" SelectedValuePath="id" IsEnabled="False" SelectionChanged="statuscmb_SelectionChanged"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Отчет с:" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dateFrom" Width="120" Height="30" VerticalAlignment="Center"/>

            <TextBlock Text="по:" FontSize="14" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker x:Name="dateTo" Width="120" Height="30" VerticalAlignment="Center"/>

            <Button x:Name="btnReport" Content="Сформировать отчет" Width="180" Height="30" Margin="15,0,0,0" FontSize="14" Click="btnReport_Click" Background="LightSkyBlue"/>
        </StackPanel>

        <DataGrid x:Name="poiskdg" Grid.Row="2" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ColumnWidth="120" SelectionChanged="poiskdg_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Трек-номер" Binding="{Binding track_number}" Width="120"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding tip}" Width="100"/>
                <DataGridTextColumn Header="Вес" Binding="{Binding fact_weight}" Width="50"/>
                <DataGridTextColumn Header="Отправитель" Binding="{Binding Pochta_Clients.FIO}" Width="220"/>
                <DataGridTextColumn Header="Телефон отправителя" Binding="{Binding Pochta_Clients.phone}" Width="150"/>
                <DataGridTextColumn Header="Получатель" Binding="{Binding Pochta_Clients1.FIO}" Width="220"/>
                <DataGridTextColumn Header="Телефон получателя" Binding="{Binding Pochta_Clients1.phone}" Width="150"/>
                <DataGridTextColumn Header="Дата приёма" Binding="{Binding date_priema, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                <DataGridTextColumn Header="Тариф" Binding="{Binding Pochta_Tarrifs.name}" Width="180"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding cost}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Pochta_Statuses.name}" Width="220"/>
                <DataGridTextColumn Header="Адрес доставки" Binding="{Binding Pochta_Clients1.address}" Width="200"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Pochta_Employees.FIO}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>