<Page x:Class="PostOffice.EmployeesManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PostOffice"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeesManagementPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="employeesdg" Grid.Row="0" CanUserAddRows="True" CanUserDeleteRows="False" IsReadOnly="False" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding lastname, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="120"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="120"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding patronymic, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="120"/>
                <DataGridComboBoxColumn Header="Должность" SelectedItemBinding="{Binding Pochta_Dolzhonst, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" DisplayMemberPath="name" Width="120"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="120"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding UserLogin, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="120"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding UserPassword, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="savechngs" Grid.Row="1" Width="120" Height="40" Content="Сохранить" FontSize="16" Margin="0 10 200 10" Click="savechngs_Click" Background="LightSkyBlue"/>

        <Button x:Name="deleteemployee" Grid.Row="1" Width="120" Height="40" Content="Уволить" FontSize="16" Margin="200 10 0 10" Click="deleteemployee_Click" Background="LightSkyBlue"/>

    </Grid>
</Page>
