<Window x:Class="PostOffice.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PostOffice"
        mc:Ignorable="d"
        Title="Добавление клиента" 
        Width="550" Height="580"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1E90FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFFFF30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1E90FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1873CC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E90FF">
            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Images/posticon.png" Width="40" Height="40" Stretch="Uniform" Margin="0,0,15,0"/>
                    <TextBlock Text="Добавление клиента" FontSize="24" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="vixod" Content="Закрыть" Style="{StaticResource HeaderCloseButtonStyle}" 
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="vixod_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="40,30,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="lastnametb" Grid.Row="0" Grid.Column="1" Style="{StaticResource InputStyle}" 
                         MaxLength="20" PreviewTextInput="LetterOnly_PreviewTextInput"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Имя" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="nametb" Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}" 
                         MaxLength="20" PreviewTextInput="LetterOnly_PreviewTextInput"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Отчество" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="patronymictb" Grid.Row="4" Grid.Column="1" Style="{StaticResource InputStyle}" 
                         MaxLength="20" PreviewTextInput="LetterOnly_PreviewTextInput"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Адрес" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="adrestb" Grid.Row="6" Grid.Column="1" Style="{StaticResource InputStyle}" 
                         MaxLength="50" PreviewTextInput="LetterDigitOnly_PreviewTextInput"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Номер телефона" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="telefontb" Grid.Row="8" Grid.Column="1" Style="{StaticResource InputStyle}" 
                         MaxLength="11" PreviewTextInput="DigitOnly_PreviewTextInput"/>
            </Grid>

            <Button x:Name="addclient" Grid.Row="1" Content="Добавить клиента" Style="{StaticResource PrimaryButtonStyle}" 
                    HorizontalAlignment="Left" Width="200" Margin="140,30,0,0" Click="addclient_Click"/>
        </Grid>
    </Grid>
</Window>