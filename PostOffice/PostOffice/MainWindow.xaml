<Window x:Class="PostOffice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PostOffice"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="500">
    <Grid Background="WhiteSmoke">
        <StackPanel Orientation="Horizontal" Width="500" Height="80" VerticalAlignment="Top" Background="DodgerBlue">
            <TextBlock Text="Почтовое отделение" Width="300" FontSize="30" Height="50" Foreground="White" Margin="100 0 0 0"/>
            <Image Height="60" Source="/Images/posticon.png" Stretch="Fill" Width="60"/>
        </StackPanel>
        <StackPanel Orientation="Vertical" Width="500" Height="300" VerticalAlignment="Center" Margin="0 80 0 0">
            <TextBlock Text="Авторизация" FontSize="25" HorizontalAlignment="Center"/>
            <TextBlock Text="Логин" FontSize="18" Margin="100 10 0 0"/>
            <TextBox x:Name="log" FontSize="18" Width="300" Height="30" Margin="0 10 0 0"/>
            <TextBlock Text="Пароль" FontSize="18" Margin="100 10 0 0"/>
            <PasswordBox x:Name="pas" FontSize="18" Width="300" Height="30" Margin="0 10 0 0"/>
            <Button x:Name="vxod" FontSize="23" Width="150" Height="40" Margin="50" Content="Вход" Background="DodgerBlue" Click="vxod_Click" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
