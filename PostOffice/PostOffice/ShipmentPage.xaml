<Page x:Class="PostOffice.ShipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PostOffice"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="ShipmentPage" Loaded="Page_Loaded">

    <Grid>
        <StackPanel Orientation="Vertical" Width="680" Height="650" HorizontalAlignment="Center" Margin="0 0 0 0 ">
            <TextBlock Text="Создание отправления" FontSize="22" Margin="0 0 0 20" Width="240" Height="30"/>
            <TextBlock Text="Тип отправления" FontSize="18" Margin="140 0 0 10"/>
            <ComboBox x:Name="tipship" Width="400" Height="30" Margin="0 0 0 15" FontSize="18" SelectionChanged="tipship_SelectionChanged">
                <ComboBoxItem Content="Письмо"/>
                <ComboBoxItem Content="Ценное письмо"/>
                <ComboBoxItem Content="Посылка"/>
                <ComboBoxItem Content="Ценная посылка"/>
                <ComboBoxItem Content="Бандероль"/>
                <ComboBoxItem Content="Ценная бандероль"/>
            </ComboBox>
            <TextBlock Text="Вес отправления" FontSize="18" Margin="140 0 0 10"/>
            <TextBox x:Name="weightship" FontSize="18" Width="400" Height="30" Margin="0 0 0 15" MaxLength="5" PreviewTextInput="DigitOnly_PreviewTextInput"/>
            <TextBlock Text="Ценность отправления" FontSize="18" Margin="140 0 0 10"/>
            <TextBox x:Name="costship" FontSize="18" Width="400" Height="30" Margin="0 0 0 15" MaxLength="6" PreviewTextInput="DigitOnly_PreviewTextInput"/>
            
            <TextBlock Text="Отправитель" FontSize="18" Margin="140 0 0 10"/>
            <StackPanel Orientation="Horizontal" Width="400" Height="30">
                <ComboBox x:Name="sendercmb" FontSize="14" Width="310" Height="30" IsEditable="True" IsTextSearchEnabled="False" KeyUp="ClientComboBox_KeyUp" SelectedValuePath="id">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding lastname}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding name}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding patronymic}"/>
                                <TextBlock Text=" ("/>
                                <TextBlock Text="{Binding phone}" FontWeight="Bold"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="adds" FontSize="16" Width="80" Height="30" Content="Добавить" Margin="10 0 0 0" Click="adds_Click" Background="DodgerBlue" Foreground="White"/>
            </StackPanel>

            <TextBlock Text="Получатель" FontSize="18" Margin="140 10 0 10"/>
            <StackPanel Orientation="Horizontal" Width="400" Height="30">
                <ComboBox x:Name="recievercmb" FontSize="14" Width="310" Height="30" IsEditable="True" IsTextSearchEnabled="False" KeyUp="ClientComboBox_KeyUp" SelectedValuePath="id">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding lastname}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding name}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding patronymic}"/>
                                <TextBlock Text=" ("/>
                                <TextBlock Text="{Binding phone}" FontWeight="Bold"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="addr" FontSize="16" Width="80" Height="30" Content="Добавить" Margin="10 0 0 0" Click="adds_Click" Background="DodgerBlue" Foreground="White"/>
            </StackPanel>
            <TextBlock Text="Тариф" FontSize="18" Margin="140 15 0 10"/>
            <TextBox x:Name="tariftb" FontSize="18" Width="400" Height="30" IsEnabled="False"/>
            <TextBlock Text="Трек-номер" FontSize="18" Margin="140 15 0 10"/>
            <TextBox x:Name="tracknumber" FontSize="18" Width="400" Height="30" IsEnabled="False"/>
            <Button x:Name="createship" FontSize="18" Width="150" Height="40" Margin="0 20 0 0" Content="Создать" Click="createship_Click" Background="DodgerBlue" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
