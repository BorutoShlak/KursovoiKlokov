<Page x:Class="PostOffice.ShowTarrifsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PostOffice"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShowTarrifsPage" Loaded="Page_Loaded">

    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="tarrifsdg" Grid.Row="1" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" AutoGenerateColumns="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ColumnWidth="120" FontSize="18">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Тип отправления" Binding="{Binding tip}" Width="200"/>
                    <DataGridTextColumn Header="Максимальный вес" Binding="{Binding weight}" Width="200"/>
                    <DataGridTextColumn Header="Стоимость" Binding="{Binding cost}" Width="120"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
