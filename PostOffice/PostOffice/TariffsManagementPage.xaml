<Page x:Class="PostOffice.TariffsManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PostOffice"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TariffsManagementPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="tariffsdg" Grid.Row="0" CanUserAddRows="True" CanUserDeleteRows="False" IsReadOnly="False" AutoGenerateColumns="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип отправления" Binding="{Binding tip, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                <DataGridTextColumn Header="Максимальный вес отправления" Binding="{Binding weight, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding cost, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                <DataGridTextColumn Header="Название" Binding="{Binding name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="savechngs" Grid.Row="1" Width="120" Height="40" Content="Сохранить" FontSize="16" Margin="0 10 200 10" Click="savechngs_Click" Background="LightSkyBlue"/>

        <Button x:Name="deletetarrif" Grid.Row="1" Width="120" Height="40" Content="Удалить" FontSize="16" Margin="200 10 0 10" Click="deletetarrif_Click" Background="LightSkyBlue"/>
    </Grid>
</Page>
