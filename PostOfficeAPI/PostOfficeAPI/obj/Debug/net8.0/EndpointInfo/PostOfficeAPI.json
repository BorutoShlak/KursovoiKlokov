{
  "openapi": "3.0.1",
  "info": {
    "title": "PostOfficeAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/Shipments/track/{trackNumber}": {
      "get": {
        "tags": [
          "Shipments"
        ],
        "parameters": [
          {
            "name": "trackNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentDTO"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/Shipments/phone/{phone}": {
      "get": {
        "tags": [
          "Shipments"
        ],
        "parameters": [
          {
            "name": "phone",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShipmentBriefDTO"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShipmentBriefDTO"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShipmentBriefDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Shipments/track/{trackNumber}/history": {
      "get": {
        "tags": [
          "Shipments"
        ],
        "parameters": [
          {
            "name": "trackNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StatusHistoryDTO"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StatusHistoryDTO"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StatusHistoryDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Shipments": {
      "post": {
        "tags": [
          "Shipments"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentCreatedResponseDTO"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentCreatedResponseDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentCreatedResponseDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/Tariffs": {
      "get": {
        "tags": [
          "Tariffs"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TariffDTO"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TariffDTO"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TariffDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Tariffs/{id}": {
      "get": {
        "tags": [
          "Tariffs"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/TariffDTO"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TariffDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TariffDTO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateShipmentDTO": {
        "required": [
          "receiverPhone",
          "senderPhone",
          "shipmentType",
          "weight"
        ],
        "type": "object",
        "properties": {
          "shipmentType": {
            "minLength": 1,
            "pattern": "^(Письмо|Ценное письмо|Посылка|Ценная посылка|Бандероль|Ценная бандероль)$",
            "type": "string"
          },
          "weight": {
            "maximum": 99999,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "declaredValue": {
            "maximum": 1000000,
            "minimum": 0,01,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "senderPhone": {
            "minLength": 1,
            "pattern": "^\\d{11}$",
            "type": "string"
          },
          "receiverPhone": {
            "minLength": 1,
            "pattern": "^\\d{11}$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ShipmentBriefDTO": {
        "type": "object",
        "properties": {
          "track_number": {
            "type": "string",
            "nullable": true
          },
          "tip": {
            "type": "string",
            "nullable": true
          },
          "date_priema": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ShipmentCreatedResponseDTO": {
        "type": "object",
        "properties": {
          "trackNumber": {
            "type": "string",
            "nullable": true
          },
          "tariffName": {
            "type": "string",
            "nullable": true
          },
          "finalCost": {
            "type": "number",
            "format": "double"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ShipmentDTO": {
        "type": "object",
        "properties": {
          "track_number": {
            "type": "string",
            "nullable": true
          },
          "tip": {
            "type": "string",
            "nullable": true
          },
          "fact_weight": {
            "type": "string",
            "nullable": true
          },
          "sender": {
            "type": "string",
            "nullable": true
          },
          "receiver": {
            "type": "string",
            "nullable": true
          },
          "date_priema": {
            "type": "string",
            "format": "date-time"
          },
          "tariff": {
            "type": "string",
            "nullable": true
          },
          "cost": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "employee": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StatusHistoryDTO": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "nullable": true
          },
          "date_of_change": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "TariffDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "tip": {
            "type": "string",
            "nullable": true
          },
          "weight": {
            "type": "integer",
            "format": "int32"
          },
          "cost": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}